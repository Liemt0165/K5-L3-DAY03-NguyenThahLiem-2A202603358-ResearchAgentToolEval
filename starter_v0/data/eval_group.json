{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "20 case nhóm v2 (10 single-turn + 10 multi-turn), bao phủ cả 2 tool mới github_search và deduplicate cùng toàn bộ allowed_failure_types.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_github_search_routing",
      "phase": "B",
      "suite": "group",
      "query": "Tìm giúp mình các repo GitHub mã nguồn mở nhiều sao nhất về MCP server.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "github_search",
            "args": {
              "sort": "stars"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_github_search",
        "difficulty": "easy",
        "what_it_tests": "Tìm repo mã nguồn mở trên GitHub → gọi tool mới github_search với sort=stars."
      }
    },
    {
      "id": "G02_deduplicate_provided_sources",
      "phase": "B",
      "suite": "group",
      "query": "Chỉ lọc các nguồn URL trùng, giữ item đầu tiên. Không tìm thêm hay định dạng. Danh sách: [{\"url\": \"https://example.com/story?utm_source=mail\", \"title\": \"First\"}, {\"url\": \"https://example.com/story\", \"title\": \"Second\"}]",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "deduplicate",
            "args": {
              "items": [
                {
                  "url": "https://example.com/story?utm_source=mail",
                  "title": "First"
                },
                {
                  "url": "https://example.com/story",
                  "title": "Second"
                }
              ]
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_deduplicate",
        "difficulty": "easy",
        "what_it_tests": "Chọn tool deduplicate khi đã có item; truyền nguyên dữ liệu để tool tự lọc, không tự chuẩn hóa trước."
      }
    },
    {
      "id": "G03_ylecun_handle_mapping",
      "phase": "B",
      "suite": "group",
      "query": "Lấy 3 tweet mới nhất của Yann LeCun",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "ylecun",
              "limit": 3
            }
          }
        ]
      },
      "metadata": {
        "skill": "name_to_handle_ylecun",
        "difficulty": "medium",
        "what_it_tests": "Map tên Yann LeCun thành handle ylecun (không có @) và limit=3."
      }
    },
    {

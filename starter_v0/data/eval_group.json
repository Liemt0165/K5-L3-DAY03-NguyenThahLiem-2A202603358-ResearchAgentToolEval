      "suite": "group",
      "query": "Tra trong chính sách nội bộ công ty: có được đưa dữ liệu khách hàng bí mật vào công cụ AI bên ngoài không?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
